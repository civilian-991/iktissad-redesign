{
  "expo": {
    "name": "الاقتصاد والأعمال",
    "slug": "iktissad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iktissad",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.iktissad.app",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ar",
        "ITSAppUsesNonExemptEncryption": false,
        "ExpoLocalization_forcesRTL": true,
        "CFBundleLocalizations": [
          "ar",
          "ar"
        ]
      }
    },
    "android": {
      "package": "com.iktissad.app",
      "adaptiveIcon": {
        "backgroundColor": "#183B4E",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/images/splash-logo-android.png",
            "imageWidth": 288,
            "backgroundColor": "#FFFFFF",
            "resizeMode": "contain"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "ar"
            ],
            "android": [
              "ar"
            ]
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "25fb51c1-f791-4133-abe9-d87df77efbd8"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "civilian-991",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25fb51c1-f791-4133-abe9-d87df77efbd8"
    }
  }
}
